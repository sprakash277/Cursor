# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key

# Server Configuration
HOST=0.0.0.0
PORT=5000

# File Paths - All data files are stored in the data/ folder
# Excel file must be placed at: data/sanskriti-3.xlsx
# All JSON files (scores, judges, participants, etc.) are stored in data/ folder
EXCEL_FILE_PATH=/home/username/scoring_app/data/sanskriti-3.xlsx
UPLOAD_FOLDER=/home/username/scoring_app/uploads
DATA_FOLDER=/home/username/scoring_app/data
